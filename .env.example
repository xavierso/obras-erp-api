# Copia este archivo como .env y rellena tus valores reales.

DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/obras_db

SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_NAME=Obras ERP API
DEBUG=True

# Carpeta donde se guardan fotos/documentos/logos subidos (local por ahora)
STORAGE_DIR=storage

# Orígenes permitidos para CORS, separados por coma. "*" = cualquiera
# (cómodo en desarrollo, cámbialo antes de producción).
ALLOWED_ORIGINS=*
